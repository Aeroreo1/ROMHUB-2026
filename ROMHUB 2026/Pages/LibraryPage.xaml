<Page x:Class="ROMHub.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Library">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Grid.Row="0"
                   Text="ROM Library"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Library Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- IMPORTANT:
                 StackPanel forces each category to appear
                 underneath the previous one.
            -->
            <StackPanel Orientation="Vertical">

                <!-- Nintendo -->
                <Expander Header="Nintendo"
                          Margin="0,0,0,10"
                          Padding="10"
                          HorizontalAlignment="Stretch">

                    <StackPanel Margin="10">

                        <Button Content="Nintendo DS"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="Nintendo 3DS"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="Game Boy"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="Game Boy Advance"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="Nintendo 64"
                                Height="40"
                                Margin="0,0,0,5"/>

                    </StackPanel>

                </Expander>


                <!-- PlayStation -->
                <Expander Header="PlayStation"
                          Margin="0,0,0,10"
                          Padding="10"
                          HorizontalAlignment="Stretch">

                    <StackPanel Margin="10">

                        <Button Content="PlayStation 1"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="PlayStation 2"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="PlayStation 3"
                                Height="40"
                                Margin="0,0,0,5"/>

                    </StackPanel>

                </Expander>


                <!-- Xbox -->
                <Expander Header="Xbox"
                          Margin="0,0,0,10"
                          Padding="10"
                          HorizontalAlignment="Stretch">

                    <StackPanel Margin="10">

                        <Button Content="Xbox"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="Xbox 360"
                                Height="40"
                                Margin="0,0,0,5"/>

                    </StackPanel>

                </Expander>


                <!-- Sega -->
                <Expander Header="Sega"
                          Margin="0,0,0,10"
                          Padding="10"
                          HorizontalAlignment="Stretch">

                    <StackPanel Margin="10">

                        <Button Content="Mega Drive"
                                Height="40"
                                Margin="0,0,0,5"/>

                        <Button Content="Dreamcast"
                                Height="40"
                                Margin="0,0,0,5"/>

                    </StackPanel>

                </Expander>


                <!-- PC -->
                <Expander Header="PC"
                          Margin="0,0,0,10"
                          Padding="10"
                          HorizontalAlignment="Stretch">

                    <StackPanel Margin="10">

                        <Button Content="Windows Games"
                                Height="40"
                                Margin="0,0,0,5"/>

                    </StackPanel>

                </Expander>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>