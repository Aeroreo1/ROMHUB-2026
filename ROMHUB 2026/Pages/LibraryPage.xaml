<Page x:Class="ROMHub.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Library">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="Library"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <Button Content="Add ROM"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="AddRom_Click"/>

        </DockPanel>


        <!-- ROM Library -->
        <ListView x:Name="RomsListView"
                  Grid.Row="1"
                  BorderThickness="0"
                  Background="Transparent">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="4,12,0,8" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>


            <ListView.ItemTemplate>
                <DataTemplate>

                    <!-- ROM Card -->
                    <Border Width="220"
                            Height="300"
                            Margin="8"
                            Padding="10"
                            Background="White"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="8">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- top area with image and overflow button -->
                            <Grid Grid.Row="0">
                                <Border Height="170"
                                        Background="#EEEEEE"
                                        CornerRadius="5">
                                    <Image Stretch="UniformToFill"
                                           Width="200"
                                           Height="170">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource MultiImagePathToBitmapConverter}">
                                                <Binding Path="CoverImagePath" />
                                                <Binding Path="PlatformTag" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Border>

                                <!-- 3-dot overflow button -->
                                <Button x:Name="OverflowButton"
                                        Content="⋮"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,4,0"
                                        Opacity="0.85"
                                        ToolTip="Options"
                                        Click="OverflowButton_Click"
                                        CommandParameter="{Binding}" />


                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <!-- Game Title -->
                                <TextBlock Text="{Binding Title}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Margin="0,0,0,2"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Platform -->
                                <TextBlock Text="{Binding Platform}"
                                           FontSize="13"
                                           Foreground="Gray"/>

                                <!-- File Path -->
                                <TextBlock Text="{Binding FilePath}"
                                           FontSize="10"
                                           Foreground="DarkGray"
                                           Margin="0,5,0,8"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Launch"
                                            Width="85"
                                            Height="30"
                                            Margin="0,0,8,0"
                                            Click="LaunchRomWithDefaultEmulator_Click"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="☆"
                                            Width="40"
                                            Height="30"
                                            FontSize="18"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Page>