<Window x:Class="ROMHub.Windows.AddRomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add ROM" Height="300" Width="500" WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Title:" Width="80" VerticalAlignment="Center" />
            <TextBox x:Name="TitleTextBox" Width="360" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Platform:" Width="80" VerticalAlignment="Center" />
            <ComboBox x:Name="PlatformComboBox" Width="360" SelectedIndex="0">
                <ComboBoxItem>GameBoy Advanced (GBA)</ComboBoxItem>
                <ComboBoxItem>DS</ComboBoxItem>
                <ComboBoxItem>Wii</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="File Path:" Width="80" VerticalAlignment="Center" />
            <TextBox x:Name="PathTextBox" Width="300" />
            <Button Content="Browse" Margin="5,0,0,0" Click="Browse_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Cover:" Width="80" VerticalAlignment="Center" />
                <Image x:Name="CoverPreview" Width="120" Height="80" Stretch="UniformToFill" Margin="0,4,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Select Cover" Click="SelectCover_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Favourite:" Width="80" VerticalAlignment="Center" />
                <CheckBox x:Name="FavouriteCheckbox" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Save" Width="100" Margin="5" Height="20"  Click="Save_Click" />
            <Button Content="Cancel" Width="100" Margin="5" Height="20"  Click="Cancel_Click" />
        </StackPanel>

    </Grid>

</Window>
