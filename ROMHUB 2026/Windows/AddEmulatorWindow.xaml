<Window x:Class="ROMHub.Windows.AddEmulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Emulator"
        Height="450"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Add Emulator"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>


        <!-- Emulator Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">

            <TextBlock Text="Emulator Name"/>

            <TextBox x:Name="NameTextBox"
                     Height="30"
                     Margin="0,5,0,0"/>

        </StackPanel>


        <!-- Platform -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">

            <TextBlock Text="Platform"/>

            <ComboBox x:Name="PlatformComboBox"
                      Height="30"
                      Margin="0,5,0,0">

                <ComboBoxItem Content="Game Boy Advance"/>
                <ComboBoxItem Content="Nintendo DS"/>
                <ComboBoxItem Content="Nintendo Wii"/>

            </ComboBox>

        </StackPanel>


        <!-- Emulator Path -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">

            <TextBlock Text="Emulator Location"/>

            <DockPanel Margin="0,5,0,0">

                <Button Content="Browse"
                        Width="80"
                        DockPanel.Dock="Right"
                        Margin="5,0,0,0"
                        Click="BrowseEmulator_Click"/>

                <TextBox x:Name="FilePathTextBox"
                         Height="30"/>

            </DockPanel>

        </StackPanel>


        <!-- Image Path -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">

            <TextBlock Text="Emulator Image"/>

            <DockPanel Margin="0,5,0,0">

                <Button Content="Browse"
                        Width="80"
                        DockPanel.Dock="Right"
                        Margin="5,0,0,0"
                        Click="BrowseImage_Click"/>

                <TextBox x:Name="ImagePathTextBox"
                         Height="30"/>

            </DockPanel>

        </StackPanel>


        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">

            <Button Content="Cancel"
                    Width="90"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Save Emulator"
                    Width="110"
                    Height="35"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>

