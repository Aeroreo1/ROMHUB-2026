<Window x:Class="ROMHub.Windows.AddEmulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Emulator"
        Height="450"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Add Emulator"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>


        <!-- Emulator Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">

            <TextBlock Text="Emulator Name"/>

            <TextBox x:Name="NameTextBox"
                     Height="30"
                     Margin="0,5,0,0"/>

        </StackPanel>


        <!-- Platform -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">

            <TextBlock Text="Platform"/>

            <ComboBox x:Name="PlatformComboBox"
                      Height="30"
                      Margin="0,5,0,0"
                      SelectionChanged="PlatformComboBox_SelectionChanged">

                <ComboBoxItem Content="Nintendo Entertainment System (NES) [nes; nintendo entertainment system]" Tag="nes" />
                <ComboBoxItem Content="Game Boy Advance (GBA) [gba; gameboy advance; gameboy]" Tag="gba" />
                <ComboBoxItem Content="DS [ds; nintendo ds]" Tag="ds" />
                <ComboBoxItem Content="Nintendo 3DS [3ds; nintendo 3ds]" Tag="3ds" />
                <ComboBoxItem Content="Nintendo GameCube &amp; Wii [gamecube; gc; wii]" Tag="gamecube" />
                <ComboBoxItem Content="Nintendo WiiU [wiiu; nintendo wiiu]" Tag="wiiu" />
                <ComboBoxItem Content="Nintendo Switch [switch; ns; nintendo switch]" Tag="switch" />
                <ComboBoxItem Content="PlayStation 1 [ps1; playstation1; playstation]" Tag="ps1" />
                <ComboBoxItem Content="PlayStation 2 [ps2; playstation2]" Tag="ps2" />
                <ComboBoxItem Content="PlayStation 3 [ps3; playstation3]" Tag="ps3" />
                <ComboBoxItem Content="PlayStation 4 [ps4; playstation4]" Tag="ps4" />
                <ComboBoxItem Content="Xbox 360 [xbox360; x360]" Tag="xbox360" />
                <ComboBoxItem Content="Retro Classics [retro; classic; retro classics]" Tag="retro" />
                <ComboBoxItem Content="Other [other; misc; miscellaneous]" Tag="other" />

            </ComboBox>

        </StackPanel>

        <!-- (Platform Tag is set via the emulator overflow menu) -->


        <!-- Emulator Path -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">

            <TextBlock Text="Emulator Location"/>

            <DockPanel Margin="0,5,0,0">

                <Button Content="Browse"
                        Width="80"
                        DockPanel.Dock="Right"
                        Margin="5,0,0,0"
                        Click="BrowseEmulator_Click"/>

                <TextBox x:Name="FilePathTextBox"
                         Height="30"/>

            </DockPanel>

        </StackPanel>


        <!-- Image Path -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">

            <TextBlock Text="Emulator Image"/>

            <DockPanel Margin="0,5,0,0">

                <Button Content="Browse"
                        Width="80"
                        DockPanel.Dock="Right"
                        Margin="5,0,0,0"
                        Click="BrowseImage_Click"/>

                <TextBox x:Name="ImagePathTextBox"
                         Height="30" TextChanged="ImagePathTextBox_TextChanged"/>

            </DockPanel>

        </StackPanel>

        <!-- Preview removed per request -->


        <!-- Buttons -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">

            <Button Content="Cancel"
                    Width="90"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Save Emulator"
                    Width="110"
                    Height="35"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>

